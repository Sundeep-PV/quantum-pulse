# Root-level example. Each package also has its own .env.example with just the
# variables it needs — copy from there when setting up a single package.
# This file is a reference for the full set used across the project.

# --- Quantinnel shared backend (services/pulse-api) ---
DATABASE_URL="postgresql://pulse:pulse@localhost:5432/quantum_pulse?schema=public"
QUANTINNEL_SERVICE_TOKEN=""        # shared service-to-service auth token, issued by Quantinnel platform team
PORT=3000

# --- Stripe ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""                 # the course's one-time price object

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""            # e.g. whatsapp:+14155238886
TWILIO_TEMPLATE_SID=""             # approved daily-lesson template

# --- Cloudflare edge (edge/access-worker) ---
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
QUANTUM_AUTH_KV_NAMESPACE_ID=""
LESSON_PAGES_BASE_URL="https://pulse.quantumreadyea.org"

# --- Web embed (web-embed/pulse-widget) ---
VITE_PULSE_API_BASE_URL="http://localhost:3000"
